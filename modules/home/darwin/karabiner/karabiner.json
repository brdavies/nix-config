{
    "global": { "check_for_updates_on_startup": false },
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Caps Lock as Control for Specific Apps",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": [
                                            "^com\\.apple\\.Terminal$",
                                            "^org\\.gnu\\.Emacs$",
                                            "^com\\.microsoft\\.VSCode$",
                                            "^com\\.jetbrains\\.pycharm\\.ce$",
                                            "^com\\.github\\.wez\\.wezterm$",
                                            "^dev\\.zed\\.Zed$"
                                        ],
                                        "type": "frontmost_application_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "key_code": "left_control" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Caps Lock as Command for Everything Else",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": [
                                            "^com\\.apple\\.Terminal$",
                                            "^org\\.gnu\\.Emacs$",
                                            "^com\\.microsoft\\.VSCode$",
                                            "^com\\.jetbrains\\.pycharm\\.ce$",
                                            "^com\\.github\\.wez\\.wezterm$",
                                            "^dev\\.zed\\.Zed$"
                                        ],
                                        "type": "frontmost_application_unless"
                                    }
                                ],
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "key_code": "left_command" }],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "devices": [
                {
                    "identifiers": {
                        "is_pointing_device": true,
                        "product_id": 9505,
                        "vendor_id": 2362
                    },
                    "ignore": false
                }
            ],
            "fn_function_keys": [
                {
                    "from": { "key_code": "f6" },
                    "to": [{ "key_code": "f6" }]
                }
            ],
            "name": "Default profile",
            "selected": true,
            "virtual_hid_keyboard": {
                "country_code": 0,
                "keyboard_type_v2": "ansi"
            }
        }
    ]
}